{
  "openapi": "3.0.3",
  "info": {
    "title": "Kizuna Rail API",
    "version": "1.0.0",
    "description": "W03 independent Trips feature"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "Trip": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "region",
          "startStation",
          "endStation",
          "duration",
          "bestSeason",
          "distance",
          "highlights",
          "operatingMonths"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "startStation": {
            "type": "string"
          },
          "endStation": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "bestSeason": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "distance": {
            "type": "number",
            "minimum": 0
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operatingMonths": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/trips": {
      "get": {
        "tags": [
          "Trips"
        ],
        "summary": "List trips",
        "responses": {
          "200": {
            "description": "All trips",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "trips"
                  ],
                  "properties": {
                    "trips": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trip"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{id}": {
      "get": {
        "tags": [
          "Trips"
        ],
        "summary": "Get trip by public ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "alpine-panorama"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching trip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            }
          },
          "404": {
            "description": "Trip not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": []
}
