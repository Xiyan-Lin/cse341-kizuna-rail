<%- include('../partials/header') %>
<h1><%= title %></h1>
<div id="filters">
    <label for="trip-region-filter">Search by Region:</label>
    <select id="trip-region-filter"><option value="all">All Regions</option></select>
    <label for="trip-season-filter">Search by Season:</label>
    <select id="trip-season-filter"><option value="all">Any Season</option></select>
</div>
<p id="trips-loading" role="status">Loading trips...</p>
<p id="trips-error" role="alert" hidden></p>
<p id="trips-empty" role="status" hidden>No trips match your filters.</p>
<div class="routes-grid" id="trips-list"></div>
<template id="trip-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>
        <div class="station-info">
            <div class="station"><div class="station-type">From:</div><div class="station-name" data-field="startStation"></div></div>
            <div class="route-arrow">&#8594;</div>
            <div class="station"><div class="station-type">To:</div><div class="station-name" data-field="endStation"></div></div>
        </div>
        <div class="route-details">
            <div class="detail-item"><span class="detail-icon">&#128337;</span><span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span></div>
            <div class="detail-item"><span class="detail-icon">&#128205;</span><span><span class="detail-label">Distance:</span> <span data-field="distance"></span></span></div>
            <div class="detail-item"><span class="season-badge" data-field="bestSeason"></span></div>
        </div>
        <div class="route-description" data-field="description"></div>
        <div class="highlights"><div class="highlights-list" data-field="highlights"></div></div>
        <div class="route-actions"><a class="view-details-btn" data-field="details">View Details &amp; Book &#8594;</a></div>
    </div>
</template>
<script type="module" src="/js/trips-catalog.js"></script>
<%- include('../partials/footer') %>
